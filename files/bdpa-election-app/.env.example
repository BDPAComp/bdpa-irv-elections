# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git

# BDPA HSCC API
BDPA_API_BASE_URL=https://hscc18f802d3.docs.apiary.io
BDPA_API_KEY=your-team-api-key-here

# JWT signing secret (generate a random 32+ char string)
JWT_SECRET=replace-this-with-a-long-random-string-please

# Super admin initial credentials (used only on first startup)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-on-first-login

# Database path
DATABASE_PATH=./data/app.db
