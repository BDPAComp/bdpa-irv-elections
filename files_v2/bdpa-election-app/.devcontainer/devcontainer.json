{
  "name": "BDPA Election App",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",

  // Forward port 3000 so http://127.0.0.1:3000 works in the browser
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "BDPA Election App",
      "onAutoForward": "openBrowser"
    }
  },

  // Auto-install dependencies after the container is built
  "postCreateCommand": "npm install && npm run setup || true",

  // After codespace starts up, remind the student what to do
  "postAttachCommand": {
    "welcome": "echo '\\n🗳️  BDPA Election App ready!\\n   Run: npm run dev\\n   Then open the forwarded port 3000.\\n'"
  },

  "customizations": {
    "vscode": {
      // Extensions auto-installed for every student — keeps the editor consistent
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "yoavbls.pretty-ts-errors"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // Make sure better-sqlite3 has what it needs to compile (Linux build tools)
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "upgradePackages": true
    }
  },

  // Run as the non-root 'node' user (best practice)
  "remoteUser": "node"
}
